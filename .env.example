# ===== Core =====
PROJECT_NAME=Community Bridge
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
ADMIN_API_KEY=change-me-in-production

# ===== Database =====
DATABASE_URL=postgresql://bridge:bridge@postgres:5432/community_bridge

# ===== Redis / Queue =====
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# ===== Discord (official API) =====
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_REQUIRED_INTENTS=guilds,guild_messages,message_content

# ===== WhatsApp (Meta Cloud API / Groups API) =====
# Groups API requires an Official Business Account (OBA). If false, group
# creation/discovery falls back to MANUAL (mapping marked PENDING).
WHATSAPP_IS_OBA=false
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_BASE=https://graph.facebook.com/v21.0

# ===== Formatting =====
WHATSAPP_PREFIX=🟢 [WhatsApp]
DISCORD_PREFIX=🟣 [Discord]
BRIDGE_GENERATED_TTL_SECONDS=86400

# ===== Security =====
WEBHOOK_MAX_AGE_SECONDS=300
